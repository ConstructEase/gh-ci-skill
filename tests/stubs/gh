#!/usr/bin/env bash
# Stub gh CLI — handles only the invocations exercised by the test suite.
set -euo pipefail

case "${1:-} ${2:-}" in
  "run list")
    cat <<'JSON'
[
  {
    "databaseId": 1,
    "status": "completed",
    "conclusion": "success",
    "name": "CI",
    "workflowName": "CI",
    "headSha": "abc123",
    "event": "push",
    "createdAt": "2024-01-01T00:00:00Z",
    "url": "https://github.com/owner/repo/actions/runs/1"
  },
  {
    "databaseId": 2,
    "status": "completed",
    "conclusion": "failure",
    "name": "CI",
    "workflowName": "CI",
    "headSha": "def456",
    "event": "push",
    "createdAt": "2024-01-01T00:00:00Z",
    "url": "https://github.com/owner/repo/actions/runs/2"
  }
]
JSON
    ;;
  "run view")
    if [[ " $* " == *" --log-failed "* ]]; then
      if [ "${GH_STUB_BIG_LOG:-}" = "1" ]; then
        for i in $(seq 1 1000); do
          printf 'line %05d: some log output here padding padding\n' "$i"
        done
      else
        printf 'short log output\n'
      fi
    else
      echo '{"status":"completed","conclusion":"success","name":"CI","displayTitle":"test commit","url":"https://github.com/owner/repo/actions/runs/42"}'
    fi
    ;;
  "repo view")
    echo '{"nameWithOwner":"owner/repo"}'
    ;;
  "pr view")
    shift 2
    pr_num=""
    json_fields=""
    jq_filter=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --json) json_fields="$2"; shift 2 ;;
        --jq)   jq_filter="$2"; shift 2 ;;
        *)      pr_num="$1"; shift ;;
      esac
    done
    [ -n "$pr_num" ] || pr_num=123
    if [ "$pr_num" = "999" ]; then
      echo "no pull requests found for branch" >&2
      exit 1
    fi
    _json="{\"number\":$pr_num,\"url\":\"https://github.com/owner/repo/pull/$pr_num\",\"headRefName\":\"feature-branch\",\"headRefOid\":\"deadbeef${pr_num}456\",\"state\":\"OPEN\",\"mergeable\":\"MERGEABLE\",\"mergeStateStatus\":\"CLEAN\"}"
    if [ -n "$json_fields" ]; then
      _json="$(printf '%s\n' "$_json" | jq -c --arg fields "$json_fields" \
        '($fields | split(",")) as $fields | with_entries(select(.key as $key | $fields | index($key)))')"
    fi
    if [ -n "$jq_filter" ]; then
      printf '%s\n' "$_json" | jq -r "$jq_filter"
    else
      printf '%s\n' "$_json"
    fi
    ;;
  "api"*)
    # Optional call recorder: set GH_STUB_LOG to a writable path and every api
    # invocation is appended verbatim, one argument per line, blank-line separated.
    if [ -n "${GH_STUB_LOG:-}" ]; then
      printf '%s\n' "$@" >> "$GH_STUB_LOG"
      printf '\n' >> "$GH_STUB_LOG"
    fi
    # Route on the path in $2 to get fixture JSON
    _json=""
    case "${2:-}" in
      repos/*/commits/124/check-runs*)
        echo "gh: No commit found for SHA: 124 (HTTP 422)" >&2
        exit 1
        ;;
      repos/*/commits/125/check-runs*)
        echo "gh: Not Found (HTTP 404)" >&2
        exit 1
        ;;
      repos/*/commits/126/check-runs*)
        echo "gh: Validation Failed (HTTP 422)" >&2
        exit 1
        ;;
      repos/*/commits/999/check-runs*)
        echo "gh: No commit found for SHA: 999 (HTTP 404)" >&2
        exit 1
        ;;
      repos/*/commits/*/check-runs*)
        _json='{"total_count":0,"check_runs":[]}'
        ;;
      repos/*/pulls/*/comments|repos/*/issues/*/comments)
        _json='{"id":1,"html_url":"https://github.com/owner/repo/pull/1#issuecomment-1"}'
        ;;
      repos/*/pulls/comments/*)
        _json='{"id":3356824857,"user":{"login":"alice"},"body":"Looks good","path":"src/foo.ts","line":42,"diff_hunk":"@@ -1 +1 @@","created_at":"2024-01-01T00:00:00Z","html_url":"https://github.com/owner/repo/pull/1#discussion_r3356824857"}'
        ;;
      repos/*/issues/comments/*)
        _json='{"id":2345678,"user":{"login":"bob"},"body":"LGTM","created_at":"2024-01-01T00:00:00Z","html_url":"https://github.com/owner/repo/pull/1#issuecomment-2345678"}'
        ;;
      *)
        printf 'stub gh: unhandled api path: %s\n' "${2:-}" >&2
        exit 1
        ;;
    esac
    # Apply --jq filter if present, mirroring real gh behaviour
    shift 2
    _jq_filter=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "--jq" ] && [ -n "${2:-}" ]; then
        _jq_filter="$2"; shift 2
      else
        shift
      fi
    done
    if [ -n "$_jq_filter" ]; then
      printf '%s\n' "$_json" | jq "$_jq_filter"
    else
      printf '%s\n' "$_json"
    fi
    ;;
  *)
    printf 'stub gh: unhandled args: %s\n' "$*" >&2
    exit 1
    ;;
esac
