#!/usr/bin/env bash
# Stub gh CLI — handles only the invocations exercised by the test suite.
set -euo pipefail

case "${1:-} ${2:-}" in
  "run list")
    cat <<'JSON'
[
  {
    "databaseId": 1,
    "status": "completed",
    "conclusion": "success",
    "name": "CI",
    "workflowName": "CI",
    "headSha": "abc123",
    "event": "push",
    "createdAt": "2024-01-01T00:00:00Z",
    "url": "https://github.com/owner/repo/actions/runs/1"
  },
  {
    "databaseId": 2,
    "status": "completed",
    "conclusion": "failure",
    "name": "CI",
    "workflowName": "CI",
    "headSha": "def456",
    "event": "push",
    "createdAt": "2024-01-01T00:00:00Z",
    "url": "https://github.com/owner/repo/actions/runs/2"
  }
]
JSON
    ;;
  "run view")
    echo '{"status":"completed","conclusion":"success","name":"CI","displayTitle":"test commit","url":"https://github.com/owner/repo/actions/runs/42"}'
    ;;
  "repo view")
    echo '{"nameWithOwner":"owner/repo"}'
    ;;
  "api"*)
    # Optional call recorder: set GH_STUB_LOG to a writable path and every api
    # invocation is appended verbatim, one argument per line, blank-line separated.
    if [ -n "${GH_STUB_LOG:-}" ]; then
      printf '%s\n' "$@" >> "$GH_STUB_LOG"
      printf '\n' >> "$GH_STUB_LOG"
    fi
    # Route on the path in $2 to get fixture JSON
    _json=""
    case "${2:-}" in
      repos/*/commits/*/check-runs*)
        _json='{"total_count":0,"check_runs":[]}'
        ;;
      repos/*/pulls/*/comments|repos/*/issues/*/comments)
        _json='{"id":1,"html_url":"https://github.com/owner/repo/pull/1#issuecomment-1"}'
        ;;
      repos/*/pulls/comments/*)
        _json='{"id":3356824857,"user":{"login":"alice"},"body":"Looks good","path":"src/foo.ts","line":42,"diff_hunk":"@@ -1 +1 @@","created_at":"2024-01-01T00:00:00Z","html_url":"https://github.com/owner/repo/pull/1#discussion_r3356824857"}'
        ;;
      repos/*/issues/comments/*)
        _json='{"id":2345678,"user":{"login":"bob"},"body":"LGTM","created_at":"2024-01-01T00:00:00Z","html_url":"https://github.com/owner/repo/pull/1#issuecomment-2345678"}'
        ;;
      *)
        printf 'stub gh: unhandled api path: %s\n' "${2:-}" >&2
        exit 1
        ;;
    esac
    # Apply --jq filter if present, mirroring real gh behaviour
    shift 2
    _jq_filter=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "--jq" ] && [ -n "${2:-}" ]; then
        _jq_filter="$2"; shift 2
      else
        shift
      fi
    done
    if [ -n "$_jq_filter" ]; then
      printf '%s\n' "$_json" | jq "$_jq_filter"
    else
      printf '%s\n' "$_json"
    fi
    ;;
  *)
    printf 'stub gh: unhandled args: %s\n' "$*" >&2
    exit 1
    ;;
esac
