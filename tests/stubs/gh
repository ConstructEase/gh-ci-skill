#!/usr/bin/env bash
# Stub gh CLI — handles only the invocations exercised by the test suite.
set -euo pipefail

case "${1:-} ${2:-}" in
  "run list")
    cat <<'JSON'
[
  {
    "databaseId": 1,
    "status": "completed",
    "conclusion": "success",
    "name": "CI",
    "workflowName": "CI",
    "headSha": "abc123",
    "event": "push",
    "createdAt": "2024-01-01T00:00:00Z",
    "url": "https://github.com/owner/repo/actions/runs/1"
  },
  {
    "databaseId": 2,
    "status": "completed",
    "conclusion": "failure",
    "name": "CI",
    "workflowName": "CI",
    "headSha": "def456",
    "event": "push",
    "createdAt": "2024-01-01T00:00:00Z",
    "url": "https://github.com/owner/repo/actions/runs/2"
  }
]
JSON
    ;;
  "run view")
    echo '{"status":"completed","conclusion":"success","name":"CI","displayTitle":"test commit","url":"https://github.com/owner/repo/actions/runs/42"}'
    ;;
  "repo view")
    echo '{"nameWithOwner":"owner/repo"}'
    ;;
  "api"*)
    # Route on the path in $2
    case "${2:-}" in
      repos/*/pulls/comments/*)
        echo '{"id":3356824857,"user":{"login":"alice"},"body":"Looks good","path":"src/foo.ts","line":42,"diff_hunk":"@@ -1 +1 @@","created_at":"2024-01-01T00:00:00Z","html_url":"https://github.com/owner/repo/pull/1#discussion_r3356824857"}'
        ;;
      repos/*/issues/comments/*)
        echo '{"id":2345678,"user":{"login":"bob"},"body":"LGTM","created_at":"2024-01-01T00:00:00Z","html_url":"https://github.com/owner/repo/pull/1#issuecomment-2345678"}'
        ;;
      *)
        printf 'stub gh: unhandled api path: %s\n' "${2:-}" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    printf 'stub gh: unhandled args: %s\n' "$*" >&2
    exit 1
    ;;
esac
